{
  "name": "gpg4web",
  "version": "0.1.0",
  "description": "GNU Privacy Guard that runs in your browser — Rust + WASM OpenPGP with a post-quantum guarded vault.",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "wasm": "wasm-pack build ../crypto-core --target web --release --out-dir ../web/src/wasm && bun scripts/fix-wasm-dts.mjs",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host"
  },
  "dependencies": {
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.3",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
}
